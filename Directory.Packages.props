<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.* / ASP.NET Core — pinned to the same 10.0.x
         patch across every project so a `dotnet restore` never silently
         mixes runtime patch versions. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />

    <!-- Validation, used as a dispatcher pipeline behavior (BuildingBlocks/Messaging/ValidationBehavior.cs) -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />

    <!-- Persistence (Platform.Infrastructure) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Pinned explicitly (not just pulled in transitively by the Npgsql
         provider) because Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 only
         requires >= 10.0.4, and without an explicit reference here NuGet
         resolves the whole graph — including Host.Api/Host.Workers, which
         never reference it directly — down to that floor instead of the
         10.0.11 patch everything else in this repo is pinned to. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Maps PascalCase entities/properties to snake_case tables/columns
         automatically (docs/rules/database-rules.md's naming convention) —
         avoids ~150+ manual HasColumnName() calls across entity configs
         that would otherwise be needed and easy to get inconsistent. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- Test projects -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
